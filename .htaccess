# Szkoła Rocka — wymuszenie kanonicznego adresu: zawsze https://szkolarocka.pl/
# (bez "www", zawsze HTTPS), niezależnie od tego, jak ktoś wpisał adres.
#
# Blok owinięty w <IfModule mod_rewrite.c> jest bezpieczny: jeśli hosting nie
# ma włączonego mod_rewrite, Apache po prostu go zignoruje (strona działa jak
# wcześniej, bez przekierowań). Ta sama poprzednia strona działała na
# WordPressie, który wymaga mod_rewrite do "ładnych" adresów URL — więc na
# tym hostingu prawie na pewno jest już włączony. Mimo to sprawdź stronę
# zaraz po wgraniu tego pliku, żeby się upewnić.

<IfModule mod_rewrite.c>
	RewriteEngine On

	RewriteCond %{HTTP_HOST} ^www\.szkolarocka\.pl$ [NC,OR]
	RewriteCond %{HTTPS} off
	RewriteRule ^(.*)$ https://szkolarocka.pl/$1 [L,R=301]
</IfModule>

# Cache dla statycznych plików — obrazy/fonty rzadko się zmieniają, CSS/JS
# krótszy cache (strona jest często aktualizowana, a pliki NIE mają
# hashowanych nazw, więc długi cache na CSS/JS oznaczałby, że ktoś może
# przez jakiś czas widzieć starą wersję po Twojej zmianie). index.html
# celowo bez cache — ma się odświeżać zawsze od razu.
<IfModule mod_expires.c>
	ExpiresActive On
	ExpiresByType text/html "access plus 0 seconds"
	ExpiresByType text/css "access plus 1 day"
	ExpiresByType application/javascript "access plus 1 day"
	ExpiresByType text/javascript "access plus 1 day"
	ExpiresByType image/jpeg "access plus 1 month"
	ExpiresByType image/png "access plus 1 month"
	ExpiresByType image/svg+xml "access plus 1 month"
	ExpiresByType font/woff "access plus 1 year"
	ExpiresByType font/woff2 "access plus 1 year"
	ExpiresByType application/vnd.ms-fontobject "access plus 1 year"
</IfModule>
